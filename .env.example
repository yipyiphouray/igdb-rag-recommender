IGDB_CLIENT_ID=your_client_id_here
IGDB_CLIENT_SECRET=your_client_secret_here

# RAG backend options:
# - lightweight: NumPy embedding matrix + BM25, recommended for deployment
# - chroma: local Chroma vector store, useful for legacy/local comparison
RAG_BACKEND=lightweight

# Optional scoped chatbot LLM provider.
# If GEMINI_API_KEY is missing, Ask the Guide_ falls back to retrieved project-context excerpts.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend CORS for deployment.
# Use FRONTEND_ORIGIN for one deployed frontend URL.
# Use CORS_ALLOWED_ORIGINS for multiple comma-separated deployed frontend URLs.
FRONTEND_ORIGIN=https://your-vercel-site.vercel.app
CORS_ALLOWED_ORIGINS=

# Optional Render/free-tier recommendation tuning.
# Lower this if POST /recommendations times out or returns 502 on hosted deployment.
RECOMMENDATION_COSINE_CANDIDATE_LIMIT=12000
